{
  "annotations": {"list": []},
  "description": "Operator overview for a rustgate process. Covers system state, throughput by protocol, authorization decisions and latency, federation health, queue and resilience signals, and TLS/cert health. All panels query metrics emitted by the workspace's Prometheus exporter at /metrics.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "row",
      "title": "System overview",
      "id": 1,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Build info",
      "id": 2,
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name", "colorMode": "background"},
      "targets": [{"expr": "rustgate_build_info", "refId": "A", "legendFormat": "{{version}}"}]
    },
    {
      "type": "stat",
      "title": "Active connections",
      "id": 3,
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value"},
      "targets": [{"expr": "sum(rustgate_connections_active) + sum(rustgate_mqtt_active_sessions) + sum(rustgate_ws_active_connections)", "refId": "A", "legendFormat": "all transports"}]
    },
    {
      "type": "stat",
      "title": "Federation peers connected",
      "id": 4,
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value"},
      "targets": [{"expr": "rustgate_federation_connections", "refId": "A", "legendFormat": "peers"}]
    },
    {
      "type": "stat",
      "title": "Server cert expiry (days)",
      "id": 5,
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background"},
      "fieldConfig": {"defaults": {"unit": "d", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 7}, {"color": "green", "value": 30}]}}, "overrides": []},
      "targets": [{"expr": "rustgate_cert_expiry_seconds / 86400", "refId": "A", "legendFormat": "days"}]
    },
    {
      "type": "timeseries",
      "title": "Active sessions by transport",
      "id": 6,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "stacking": {"mode": "normal"}, "fillOpacity": 30}}, "overrides": []},
      "targets": [
        {"expr": "sum(rustgate_sessions_active)", "refId": "A", "legendFormat": "TLS / plaintext"},
        {"expr": "sum(rustgate_mqtt_active_sessions)", "refId": "B", "legendFormat": "MQTT"},
        {"expr": "sum(rustgate_ws_active_connections)", "refId": "C", "legendFormat": "WebSocket"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Connections accepted vs rejected",
      "id": 7,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "sum(rate(rustgate_connections_accepted_total[1m]))", "refId": "A", "legendFormat": "accepted/s"},
        {"expr": "sum(rate(rustgate_connections_rejected_total[1m]))", "refId": "B", "legendFormat": "rejected/s"},
        {"expr": "sum(rate(rustgate_accept_errors_total[1m]))", "refId": "C", "legendFormat": "accept errors/s"}
      ]
    },
    {
      "type": "row",
      "title": "Throughput",
      "id": 8,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 13},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Messages per second by protocol",
      "id": 9,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "stacking": {"mode": "normal"}, "fillOpacity": 25}}, "overrides": []},
      "targets": [
        {"expr": "sum(rate(rustgate_mqtt_publishes_total[1m]))", "refId": "A", "legendFormat": "MQTT publish"},
        {"expr": "sum(rate(rustgate_nats_publishes_total[1m]))", "refId": "B", "legendFormat": "NATS publish"},
        {"expr": "sum(rate(rustgate_ws_messages_total[1m]))", "refId": "C", "legendFormat": "WebSocket"},
        {"expr": "sum(rate(rustgate_federation_messages_in_total[1m])) + sum(rate(rustgate_federation_messages_out_total[1m]))", "refId": "D", "legendFormat": "Federation"},
        {"expr": "sum(rate(rustgate_http_publishes_total[1m]))", "refId": "E", "legendFormat": "HTTP egress"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Bytes per second (per-identity, summed)",
      "id": 10,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "Bps", "custom": {"drawStyle": "line", "fillOpacity": 15}}, "overrides": []},
      "targets": [
        {"expr": "sum(rate(rustgate_per_identity_bytes_received_total[1m]))", "refId": "A", "legendFormat": "inbound"},
        {"expr": "sum(rate(rustgate_per_identity_bytes_sent_total[1m]))", "refId": "B", "legendFormat": "outbound"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Messages routed by destination",
      "id": 11,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 22},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "sum by (destination) (rate(rustgate_messages_routed_total[1m]))", "refId": "A", "legendFormat": "{{destination}}"}]
    },
    {
      "type": "timeseries",
      "title": "CoT parse rate by result",
      "id": 12,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 22},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "sum by (result) (rate(rustgate_cot_parse_total[1m]))", "refId": "A", "legendFormat": "{{result}}"}]
    },
    {
      "type": "row",
      "title": "Authorization & latency",
      "id": 13,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 30},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Authz decisions per second (allow vs deny)",
      "id": 14,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 31},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "stacking": {"mode": "normal"}, "fillOpacity": 25}}, "overrides": []},
      "targets": [{"expr": "sum by (decision) (rate(rustgate_authz_decisions_total[1m]))", "refId": "A", "legendFormat": "{{decision}}"}]
    },
    {
      "type": "timeseries",
      "title": "Authz evaluations per second (engine, by decision)",
      "id": 15,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 31},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "sum by (decision) (rate(rustgate_authz_evaluations_total[1m]))", "refId": "A", "legendFormat": "{{decision}}"}]
    },
    {
      "type": "stat",
      "title": "Authz cache hit ratio (5m)",
      "id": 16,
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 39},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 0.5}, {"color": "green", "value": 0.8}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background"},
      "targets": [{"expr": "rate(rustgate_authz_cache_hits_total[5m]) / clamp_min(rate(rustgate_authz_cache_hits_total[5m]) + rate(rustgate_authz_cache_misses_total[5m]), 1)", "refId": "A", "legendFormat": "hit ratio"}]
    },
    {
      "type": "stat",
      "title": "Authz evaluations in flight",
      "id": 17,
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 39},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value"},
      "targets": [{"expr": "rustgate_authz_evaluations_in_flight", "refId": "A", "legendFormat": "in-flight"}]
    },
    {
      "type": "timeseries",
      "title": "Authz evaluation latency (p50 / p95 / p99)",
      "id": 18,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 39},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(rustgate_authz_evaluation_seconds_bucket[5m])))", "refId": "A", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(rustgate_authz_evaluation_seconds_bucket[5m])))", "refId": "B", "legendFormat": "p95"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(rustgate_authz_evaluation_seconds_bucket[5m])))", "refId": "C", "legendFormat": "p99"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Obligations emitted by type",
      "id": 19,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 43},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "sum by (obligation_type) (rate(rustgate_authz_obligations_emitted_total[1m]))", "refId": "A", "legendFormat": "{{obligation_type}}"}]
    },
    {
      "type": "row",
      "title": "Federation",
      "id": 20,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 51},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
