      "targets": [
        {"expr": "sum(rate(rustgate_federation_messages_in_total[1m]))", "refId": "A", "legendFormat": "in/s"},
        {"expr": "sum(rate(rustgate_federation_messages_out_total[1m]))", "refId": "B", "legendFormat": "out/s"},
