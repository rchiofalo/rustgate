apiVersion: v1
kind: Service
metadata:
  labels:
    app.kubernetes.io/instance: rustgate-min
    app.kubernetes.io/managed-by: rustgate-operator
    app.kubernetes.io/name: rustgate
    rustgate.io/cluster: rustgate-min
  name: rustgate-min-headless
  namespace: default
  ownerReferences: []
spec:
  clusterIP: None
  ports:
  - name: tactical
    port: 4433
    protocol: TCP
    targetPort: 4433
  - name: federation
    port: 9001
    protocol: TCP
    targetPort: 9001
  publishNotReadyAddresses: true
  selector:
