  selector:
    app.kubernetes.io/instance: my-cluster
    app.kubernetes.io/name: rustgate
  type: ClusterIP
---
apiVersion: v1
data:
  federation-peers.json: |-
    [
      {
        "id": "my-cluster-0",
        "address": "my-cluster-0.my-cluster-headless.rustgate.svc.cluster.local:9001",
        "groups": [],
        "enabled": true,
        "is_outbound": true,
        "trust_cert_cn": null
      },
      {
        "id": "my-cluster-1",
        "address": "my-cluster-1.my-cluster-headless.rustgate.svc.cluster.local:9001",
        "groups": [],
        "enabled": true,
        "is_outbound": true,
        "trust_cert_cn": null
      },
      {
        "id": "my-cluster-2",
        "address": "my-cluster-2.my-cluster-headless.rustgate.svc.cluster.local:9001",
        "groups": [],
        "enabled": true,
        "is_outbound": true,
        "trust_cert_cn": null
      }
    ]
  rustgate.toml: |
    # rustgate.toml — managed by rustgate-operator
    # Source: RustgateCluster my-cluster

    bind = "0.0.0.0:4433"

    # Federation is enabled by the presence of these keys; the
    # per-pod federation-id is injected via the RUSTGATE_FEDERATION_ID
    # environment variable (POD_NAME) in the StatefulSet.
    federation-v2-bind = "0.0.0.0:9001"
    federation-peers-file = "/etc/rustgate/federation-peers.json"
kind: ConfigMap
metadata:
  labels:
    app.kubernetes.io/instance: my-cluster
    app.kubernetes.io/managed-by: rustgate-operator
    app.kubernetes.io/name: rustgate
    rustgate.io/cluster: my-cluster
  name: my-cluster-config
  namespace: rustgate
  ownerReferences:
  - apiVersion: rustgate.io/v1alpha1
    blockOwnerDeletion: true
    controller: true
    kind: RustgateCluster
    name: my-cluster
    uid: 00000000-0000-0000-0000-000000000001
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  labels:
    app.kubernetes.io/instance: my-cluster
    app.kubernetes.io/managed-by: rustgate-operator
    app.kubernetes.io/name: rustgate
    rustgate.io/cluster: my-cluster
  name: my-cluster-tls
  namespace: rustgate
  ownerReferences:
  - apiVersion: rustgate.io/v1alpha1
    blockOwnerDeletion: true
    controller: true
    kind: RustgateCluster
    name: my-cluster
    uid: 00000000-0000-0000-0000-000000000001
spec:
  commonName: my-cluster
  dnsNames:
  - my-cluster
  - my-cluster-headless
  - my-cluster-0.my-cluster-headless.rustgate.svc.cluster.local
  - my-cluster-1.my-cluster-headless.rustgate.svc.cluster.local
  - my-cluster-2.my-cluster-headless.rustgate.svc.cluster.local
  duration: 2160h
  issuerRef:
    kind: ClusterIssuer
    name: letsencrypt-prod
  renewBefore: 360h
  secretName: my-cluster-tls
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  labels:
    app.kubernetes.io/instance: my-cluster
    app.kubernetes.io/managed-by: rustgate-operator
    app.kubernetes.io/name: rustgate
    rustgate.io/cluster: my-cluster
  name: my-cluster
  namespace: rustgate
  ownerReferences:
  - apiVersion: rustgate.io/v1alpha1
    blockOwnerDeletion: true
    controller: true
    kind: RustgateCluster
    name: my-cluster
    uid: 00000000-0000-0000-0000-000000000001
spec:
  podManagementPolicy: Parallel
  replicas: 3
  selector:
    matchLabels:
      app.kubernetes.io/instance: my-cluster
      app.kubernetes.io/name: rustgate
  serviceName: my-cluster-headless
  template:
    metadata:
      labels:
        app.kubernetes.io/instance: my-cluster
        app.kubernetes.io/managed-by: rustgate-operator
        app.kubernetes.io/name: rustgate
        rustgate.io/cluster: my-cluster
    spec:
      containers:
      - args:
        - --config
        - /etc/rustgate/rustgate.toml
        env:
        - name: POD_NAME
          valueFrom:
            fieldRef:
              fieldPath: metadata.name
        - name: POD_NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
        - name: RUSTGATE_CONFIG
          value: /etc/rustgate/rustgate.toml
        - name: RUSTGATE_FEDERATION_ID
          valueFrom:
            fieldRef:
              fieldPath: metadata.name
        image: ghcr.io/rchiofalo/rustgate:0.8.0
        imagePullPolicy: IfNotPresent
        livenessProbe:
          initialDelaySeconds: 30
          periodSeconds: 30
          tcpSocket:
            port: 4433
        name: rustgate
        ports:
        - containerPort: 4433
          name: tactical
          protocol: TCP
        - containerPort: 9001
          name: federation
          protocol: TCP
        readinessProbe:
          initialDelaySeconds: 5
          periodSeconds: 10
          tcpSocket:
            port: 4433
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          readOnlyRootFilesystem: true
        volumeMounts:
        - mountPath: /etc/rustgate
          name: config
          readOnly: true
        - mountPath: /certs
          name: tls
          readOnly: true
        - mountPath: /data/client-queue
          name: store-forward
        - mountPath: /data/audit
          name: audit-log
      securityContext:
        fsGroup: 10001
        runAsGroup: 10001
        runAsNonRoot: true
        runAsUser: 10001
        seccompProfile:
          type: RuntimeDefault
      terminationGracePeriodSeconds: 30
      volumes:
      - configMap:
          name: my-cluster-config
        name: config
      - name: tls
        secret:
          secretName: my-cluster-tls
  volumeClaimTemplates:
  - metadata:
      name: store-forward
    spec:
      accessModes:
      - ReadWriteOnce
      resources:
        requests:
          storage: 10Gi
      storageClassName: standard
  - metadata:
      name: audit-log
    spec:
      accessModes:
      - ReadWriteOnce
      resources:
        requests:
          storage: 5Gi
      storageClassName: standard
