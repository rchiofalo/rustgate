    {
      "type": "stat",
      "title": "Inbound peers",
      "id": 2,
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "sum(rustgate_federation_connections_inbound)", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Outbound peers",
      "id": 3,
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "sum(rustgate_federation_connections_outbound)", "refId": "A"}]
    },
    {
      "type": "stat",
