    {
      "type": "timeseries",
      "title": "Authz decisions rate (by action & decision)",
      "id": 1,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 1},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {"custom": {"stacking": {"mode": "normal"}}},
        "overrides": []
      },
      "targets": [
        {"expr": "sum by (action, decision) (rate(rustgate_authz_decisions_total[5m]))", "refId": "A", "legendFormat": "{{action}} / {{decision}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Authz eval latency (p50 / p95 / p99)",
      "id": 2,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 1},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(rustgate_authz_eval_nanos_bucket[5m])) by (le))", "refId": "A", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.95, sum(rate(rustgate_authz_eval_nanos_bucket[5m])) by (le))", "refId": "B", "legendFormat": "p95"},
        {"expr": "histogram_quantile(0.99, sum(rate(rustgate_authz_eval_nanos_bucket[5m])) by (le))", "refId": "C", "legendFormat": "p99"}
      ]
