# rustgate environment variables
# CLI flags take precedence over environment variables.

# ── TLS / Security ──────────────────────────────────────────────────
# TLS certificate, private key, and CA certificate (PEM files).
RUSTGATE_CERT=certs/server.pem
RUSTGATE_KEY=certs/server-key.pem
RUSTGATE_CA=certs/ca.pem

# Path to PEM-encoded Certificate Revocation List file.
# Connections using revoked certificates will be rejected at the TLS handshake.
# RUSTGATE_CRL=certs/crl.pem

# Require FIPS 140-3 crypto provider. Startup fails if the FIPS provider
# is not active. Build with --features fips to enable.
# RUSTGATE_FIPS_REQUIRED=false

# ── Listener ────────────────────────────────────────────────────────
# Bind address for the TLS listener.
RUSTGATE_BIND=0.0.0.0:4433

# Bind address for plaintext TCP input.
# WARNING: connections are NOT encrypted. Use only on trusted networks.
# RUSTGATE_TCP_BIND=0.0.0.0:8087

# Bind address for UDP CoT input.
# WARNING: datagrams are NOT encrypted. Use only on trusted networks.
# RUSTGATE_UDP_BIND=0.0.0.0:8087

# Bind address for the WebSocket (wss://) listener.
# Requires --features websocket.
# RUSTGATE_WEBSOCKET_BIND=0.0.0.0:8443

# Maximum concurrent TLS sessions. Prevents resource exhaustion
# from connection floods.
RUSTGATE_MAX_CONNECTIONS=1024

# ── Protocol ────────────────────────────────────────────────────────
# Protocol framing: xml, length-prefixed, line, tak-protobuf, tak-negotiate
RUSTGATE_FRAMING=xml

# Message encoding: raw, cot, tak-protobuf
RUSTGATE_ENCODING=raw

# ── Client Identity for Plaintext ──────────────────────────────────
# Default CN for plaintext (TCP/UDP) clients.
# RUSTGATE_PLAINTEXT_CN=anonymous

# Default group for plaintext (TCP/UDP) clients.
# RUSTGATE_PLAINTEXT_GROUP=__plaintext__

# ── Rate Limiting ───────────────────────────────────────────────────
# Maximum sustained messages per second per connected client (0 = disabled).
# RUSTGATE_CLIENT_MSG_RATE=0

# Maximum burst size for per-client rate limiting.
# RUSTGATE_CLIENT_BURST=200

# ── NATS Bridge (requires --features nats) ──────────────────────────
# NATS server URL. Enables the NATS bridge for cross-instance messaging.
# RUSTGATE_NATS_URL=nats://nats:4222

# Path to a NATS credentials file for JWT/NKey authentication.
# RUSTGATE_NATS_CREDENTIALS=

# ── Enrollment (requires --features enrollment) ─────────────────────
# Bind address for the enrollment HTTPS server.
# RUSTGATE_ENROLLMENT_BIND=0.0.0.0:8446

# CA private key for signing client CSRs (required when enrollment is enabled).
# RUSTGATE_CA_KEY=certs/ca-key.pem

# HTTP Basic Auth credentials for enrollment (required when enrollment is enabled).
# RUSTGATE_ENROLLMENT_USER=admin
# RUSTGATE_ENROLLMENT_PASSWORD=changeme

# Organization name for issued client certificates.
RUSTGATE_CA_ORG=rustgate

# Directory for data package storage. Enables the Marti sync API
# endpoints when set. Requires --features enrollment.
# RUSTGATE_DATA_PACKAGE_DIR=

# Maximum age (in hours) for uploaded data packages. Packages older than
# this are eligible for cleanup. 0 = no expiration.
# RUSTGATE_PACKAGE_MAX_AGE_HOURS=0

# ── Metrics (requires --features metrics) ────────────────────────────
# Bind address for the Prometheus metrics and health HTTP server.
# Exposes /healthz, /readyz, and /metrics endpoints.
# RUSTGATE_METRICS_BIND=0.0.0.0:9090

# ── Federation (requires --features federation) ─────────────────────
# V1 federation listen address (enables federation when set).
# RUSTGATE_FEDERATION_V1_BIND=0.0.0.0:9000

# V2 gRPC federation listen address.
# Enables V2 gRPC inbound server when set alongside --federation-v1-bind.
# RUSTGATE_FEDERATION_V2_BIND=0.0.0.0:9001

# Unique federation server identity.
# RUSTGATE_FEDERATION_ID=rustgate-federation-1

# Path to JSON file containing federation peer configurations.
# RUSTGATE_FEDERATION_PEERS_FILE=

# Skip TLS hostname verification for federation peers.
# RUSTGATE_FEDERATION_SKIP_HOSTNAME_VERIFY=false

# Maximum federation hops before dropping a message (loop prevention).
# RUSTGATE_FEDERATION_MAX_HOPS=10

# Path to persistent federate store (JSON file).
# RUSTGATE_FEDERATION_STORE_PATH=

# Directory containing additional trusted CA certificates for federation.
# PEM/CRT files in this directory are merged with --ca for TLS verification.
# RUSTGATE_FEDERATION_TRUST_STORE_DIR=

# Consecutive send failures before tripping a federation peer's circuit breaker.
# RUSTGATE_FEDERATION_CIRCUIT_BREAKER_THRESHOLD=5

# Seconds to wait after a circuit breaker trips before probing a federation peer.
# RUSTGATE_FEDERATION_CIRCUIT_BREAKER_TIMEOUT=60

# NATS URL for federation HA coordination (enables distributed peer ownership).
# When set, only one pod manages each outbound peer in a multi-pod deployment.
# Requires --features federation-ha.
# RUSTGATE_FEDERATION_HA_NATS_URL=

# Pod identifier for federation HA mode. Defaults to RUSTGATE_FEDERATION_ID if
# RUSTGATE_FEDERATION_HA_NATS_URL is set.
# RUSTGATE_FEDERATION_POD_ID=

# ── Archival ─────────────────────────────────────────────────────────
# Directory for CoT event archival (JSONL). Enables structured logging of
# all received CoT events to date-stamped files.
# RUSTGATE_ARCHIVE_DIR=

# ── Logging ──────────────────────────────────────────────────────────
# Standard Rust tracing filter. Examples: info, debug, rustgate=trace
RUST_LOG=info
