# rustgate environment variables
# CLI flags take precedence over environment variables.

# ── Core ─────────────────────────────────────────────────────────────
# Bind address for the TAK TCP/TLS listener.
RUSTGATE_BIND=0.0.0.0:4433

# TLS certificate, private key, and CA certificate (PEM files).
RUSTGATE_CERT=certs/server.pem
RUSTGATE_KEY=certs/server-key.pem
RUSTGATE_CA=certs/ca.pem

# Protocol framing: xml, length-prefixed, line, tak-protobuf, tak-negotiate
RUSTGATE_FRAMING=xml

# Message encoding: raw, cot, tak-protobuf
RUSTGATE_ENCODING=raw

# Maximum concurrent TLS sessions.
RUSTGATE_MAX_CONNECTIONS=1024

# ── NATS bridge (requires --features nats) ───────────────────────────
# Setting NATS_URL enables the NATS bridge for cross-instance messaging.
# NATS_URL=nats://nats:4222

# Path to a NATS credentials file for JWT/NKey authentication.
# NATS_CREDENTIALS=

# ── Enrollment (requires --features enrollment) ─────────────────────
# Setting ENROLLMENT_BIND starts the enrollment HTTPS server.
# ENROLLMENT_BIND=0.0.0.0:8446

# CA private key for signing client CSRs (required when enrollment is enabled).
# RUSTGATE_CA_KEY=certs/ca-key.pem

# HTTP Basic Auth credentials for enrollment (required when enrollment is enabled).
# ENROLLMENT_USER=admin
# ENROLLMENT_PASSWORD=changeme

# Organization name for issued client certificates.
RUSTGATE_CA_ORG=rustgate

# ── Metrics (requires --features metrics) ────────────────────────────
# Setting METRICS_BIND starts the Prometheus metrics and health HTTP server.
# Exposes /healthz, /readyz, and /metrics endpoints.
# METRICS_BIND=0.0.0.0:9090

# ── Logging ──────────────────────────────────────────────────────────
# Standard Rust tracing filter. Examples: info, debug, rustgate=trace
RUST_LOG=info
