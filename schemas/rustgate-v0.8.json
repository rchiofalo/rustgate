  "additionalProperties": false,
  "$defs": {
    "AuthzPolicyFormat": {
      "description": "Selects which dynamic federation peer discovery backend is used.\n\n`None` (the default) disables discovery entirely; static peer\nconfiguration via `--federation-peers-file` remains the only source of\ntruth. The other variants each map to a backend gated behind its own\ncargo feature (`peer-discovery-dns-sd`, `peer-discovery-consul`,\n`peer-discovery-etcd`); selecting a backend whose feature was not\ncompiled in surfaces a startup error.\nAuthz policy-file format selector.",
      "oneOf": [
        {
          "description": "Native rustgate-authz JSON ruleset.",
          "type": "string",
          "const": "native"
        },
        {
          "description": "Cedar policy corpus (requires the `cedar` feature).",
          "type": "string",
          "const": "cedar"
        }
      ]
    },
    "Encoding": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "raw",
            "cot"
          ]
        },
        {
          "description": "TAK protobuf encoding (proto <-> XML at session edge). Requires --features proto.",
          "type": "string",
          "const": "tak-protobuf"
        }
      ]
    },
    "Framing": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "xml",
            "length-prefixed",
            "line"
          ]
        },
        {
          "description": "TAK protobuf binary framing (0xBF + varint length). Requires --features proto.",
          "type": "string",
          "const": "tak-protobuf"
        },
        {
          "description": "TAK protocol negotiation: starts XML, upgrades to protobuf if the client requests it.\nThis is the mode real TAK clients expect. Requires --features proto.",
          "type": "string",
          "const": "tak-negotiate"
        }
      ]
    },
    "MqttWildcardPolicy": {
      "description": "MQTT SUBSCRIBE wildcard policy selector for the CLI / config file.\n\nMirrors `rustgate_mqtt::WildcardPolicy` but is owned by the server\ncrate so `rustgate-mqtt` does not need a clap dependency. A plain\ncode reference is used instead of an intra-doc link because the\n`rustgate-mqtt` crate is an optional dependency that is absent from\nthe default feature set used by `cargo doc --workspace --no-deps`\non the docs-site build. The defaulting behaviour\n(`single-level-only`) matches the MQTT adapter's own default so\noperators who omit the flag get spec-conformant single-level (`+`)\nwildcards without the `#` firehose.",
      "oneOf": [
        {
          "description": "Reject both `+` and `#`. Exact-topic subscriptions only.",
          "type": "string",
          "const": "reject"
        },
        {
          "description": "Accept `+` (single-level). Reject `#` (multi-level). Default.",
          "type": "string",
          "const": "single-level-only"
        },
        {
          "description": "Accept both `+` and `#`.",
          "type": "string",
          "const": "full"
        }
      ]
    },
    "PeerDiscoveryBackend": {
      "type": "string",
      "enum": [
        "none",
        "dns-sd",
        "consul",
        "etcd"
      ]
    }
  }
}